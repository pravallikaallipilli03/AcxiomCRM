@model AcxiomCRM.Models.Opportunity
<div class="container"><h2>Create Opportunity</h2><form method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="OpportunityName" class="form-control mb-2" placeholder="Opportunity Name"/><input asp-for="Amount" class="form-control mb-2" placeholder="Amount"/><input asp-for="Probability" class="form-control mb-2" placeholder="Probability 0-100"/><select asp-for="Stage" class="form-control mb-2"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select><input asp-for="ExpectedCloseDate" type="date" class="form-control mb-2"/><button class="btn btn-success">Save</button></form></div>
