@model AcxiomCRM.Models.Lead
<div class="container"><h2>Create Lead</h2><form method="post"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="LeadName" class="form-control mb-2" placeholder="Lead Name"/><input asp-for="Email" class="form-control mb-2" placeholder="Email"/><input asp-for="Phone" class="form-control mb-2" placeholder="Phone"/><input asp-for="CompanyName" class="form-control mb-2" placeholder="Company"/><select asp-for="Status" class="form-control mb-2"><option>New</option><option>Contacted</option><option>Qualified</option><option>Lost</option><option>Converted</option></select><input asp-for="ExpectedValue" class="form-control mb-2" placeholder="Expected Value"/><button class="btn btn-success">Save</button></form></div>
