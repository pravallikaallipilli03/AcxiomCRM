@model System.Collections.Generic.IEnumerable<AcxiomCRM.Models.Customer>
<AcxiomCRM.Models.Customer><div class="container"><h2>Customers</h2><a class="btn btn-primary mb-3" href="/Customers/Create">Create Customer</a><form class="mb-3"><input name="search" class="form-control" placeholder="Search name, email or phone" /></form><table class="table table-bordered"><tr><th>Name</th><th>Email</th><th>Phone</th><th>Company</th><th>Status</th><th></th></tr>@foreach(var c in Model){<tr><td>@c.CustomerName</td><td>@c.Email</td><td>@c.Phone</td><td>@c.CompanyName</td><td>@c.Status</td><td><a href="/Customers/Edit/@c.CustomerId">Edit</a></td></tr>}</table></div>
